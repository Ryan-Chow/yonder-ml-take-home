# Copy this file to .env and fill it in. .env is git-ignored, so your keys stay local.
# Alternatively just `export ROBOFLOW_API_KEY=...` in your shell; the env var takes precedence.

# Used by scripts/download_data.py (and sampling/sample-roboflow.py) to download the dataset
ROBOFLOW_API_KEY=

# Used by sampling/upload-roboflow.py to upload the sample to YOUR OWN Roboflow project
PROJECT_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
